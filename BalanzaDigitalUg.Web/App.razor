    <!-- Script MEJORADO y SIMPLE para manejar layout en login -->
    <script>
        // ============================================
        // FUNCIÓN PRINCIPAL - Simple y directa
        // ============================================
        function ajustarLayoutLogin() {
            const path = window.location.pathname.toLowerCase();
            const esLogin = path.includes('/account/login');

            if (esLogin) {
                // 1. OCULTAR SIDEBAR
                const sidebar = document.querySelector('.sidebar');
                if (sidebar) {
                    sidebar.style.display = 'none';
                    sidebar.style.visibility = 'hidden';
                }

                // 2. OCULTAR TOPBAR
                const topRow = document.querySelector('.top-row');
                if (topRow) {
                    topRow.style.display = 'none';
                }

                // 3. AJUSTAR CONTENIDO PRINCIPAL
                const mainContent = document.querySelector('.flex-grow-1.bg-light');
                if (mainContent) {
                    mainContent.style.cssText = `
                        margin-left: 0 !important;
                        width: 100% !important;
                       
                        min-height: 100vh !important;
                        display: flex !important;
                        align-items: center !important;
                        justify-content: center !important;
                        padding: 20px !important;
                    `;
                }

                // 4. FONDO PARA TODO EL BODY
                //document.body.style.background = 'linear-gradient(135deg, #667eea 0%, #764ba2 100%)';

            } else {
                // RESTAURAR TODO CUANDO NO ES LOGIN
                const sidebar = document.querySelector('.sidebar');
                if (sidebar) {
                    sidebar.style.display = '';
                    sidebar.style.visibility = '';
                }

                const topRow = document.querySelector('.top-row');
                if (topRow) {
                    topRow.style.display = '';
                }

                const mainContent = document.querySelector('.flex-grow-1.bg-light');
                if (mainContent) {
                    mainContent.style.cssText = '';
                }

                document.body.style.background = '';
            }
        }

        // ============================================
        // CUÁNDO EJECUTAR LA FUNCIÓN
        // ============================================

        // 1. Cuando se carga la página (RECARGAR)
        window.addEventListener('load', function() {
            setTimeout(ajustarLayoutLogin, 300);
        });

        // 2. Cuando Blazor termina de cargar (INICIAL)
        document.addEventListener('DOMContentLoaded', function() {
            setTimeout(ajustarLayoutLogin, 500);
        });

        // 3. SOLUCIÓN CLAVE: Detectar cuando Blazor navega entre páginas
        // Esta es la parte que faltaba en tu script original
        let currentHref = location.href;

        function checkForURLChange() {
            if (location.href !== currentHref) {
                currentHref = location.href;
                // Pequeña pausa para que Blazor renderice la nueva página
                setTimeout(ajustarLayoutLogin, 100);
            }
        }

        // Verificar cambios cada 100ms (suficiente para SPA)
        setInterval(checkForURLChange, 100);

        // 4. También cuando el usuario usa botones atrás/adelante
        window.addEventListener('popstate', function() {
            setTimeout(ajustarLayoutLogin, 150);
        });
    </script>

