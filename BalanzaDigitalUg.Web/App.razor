    <!-- Inicialización automática -->
    <script>
        // Inicializar cuando Blazor esté listo
        window.addEventListener('load', function() {
            // Inicializar tema
            if (window.ThemeManager) {
                const themeManager = new ThemeManager();
                themeManager.init();
            }

            // Inicializar botones de contraseña
            if (window.PasswordToggle && typeof PasswordToggle.initAll === 'function') {
                setTimeout(() => {
                    PasswordToggle.initAll();
                }, 500);
            }
        });

        // También inicializar después de cada renderizado de Blazor
        window.addEventListener('blazor-ready', function() {
            if (window.PasswordToggle && typeof PasswordToggle.initAll === 'function') {
                PasswordToggle.initAll();
            }
        });
    </script>

